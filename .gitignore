node_modules/
dist/
.DS_Store

# Local Netlify folder
.netlify

# raw Natural Earth source for cities.json (derived output lives in public/data)
places.geojson

# z6 land-polygon coastline grid (generated at build time, not committed — present on disk for Netlify deploy)
public/data/coast-z6/

# tiled Overture water layer (generated by `npm run build:watertiles`, not
# committed — same reasoning as coast-z6: present on disk for Netlify deploy,
# regenerate locally rather than bloating git with ~85 MB of derived tiles)
public/data/water-tiles/

# tuiles BATHYMÉTRIQUES cuites depuis GEBCO (et sources côtières) — même
# raisonnement que coast-z6 : présentes sur disque pour le deploy Netlify,
# hors dépôt parce qu'elles se refabriquent (npm run build:bathytiles)
public/data/bathy/
# format pivot brut du tuileur : gros, régénérable, jamais versionné
data/

# tiled Overture WORLD lake layer (generated by `npm run build:laketiles`,
# not committed — same reasoning as water-tiles above: global
# lake-only coverage, present on disk for Netlify deploy, regenerate locally
# rather than bloating git, see build-world-lake-tiles.mjs / task-19 report)
public/data/lake-tiles/

# découpage géographique des couches Natural Earth en cellules (généré par
# `npm run build:mapcells`, cf. scripts/build-map-cells.mjs). Même raisonnement
# que lake-tiles/road-tiles ci-dessus : 5 852 fichiers, 54 Mo sur disque,
# entièrement dérivés des monolithes public/data/map/*.json qui, eux, RESTENT
# versionnés — ils sont à la fois la source du découpage et le filet de repli
# du chargeur (src/map/geo-data.js) si le manifeste de cellules manque.
# À régénérer avant chaque déploiement : voir l'en-tête du script.
public/data/map/cells/

_staging/
